VITE_APP_ENV=development
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SUPABASE_SESSION_AUDIO_BUCKET=session-audio
# Optional: Pfad zur internen Proxy-Route (Standard: /functions/v1/openai-chat-proxy)
VITE_OPENAI_PROXY_PATH=/functions/v1/openai-chat-proxy

# Optional: AI-Coach-Session-Plan aus Runtime aktivieren (Standard: false)
VITE_ENABLE_AI_COACH_SESSION_PLAN=false

# Optional: AI-Coach-Next-Step-Feedback aus Runtime aktivieren (Standard: false)
VITE_ENABLE_AI_COACH_NEXT_STEP=false

# Optional: AI-Coach-dynamische Next-Task aus Runtime aktivieren (Standard: false)
VITE_ENABLE_AI_COACH_DYNAMIC_NEXT_STEP=false

# Billing (Supabase Edge Functions Secrets via `supabase secrets set`)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# APP_BASE_URL=https://your-app-domain.tld

# Optional: AI-Coach-Training-Empfehlungen im Tutor-Hero aktivieren (Standard: false)
VITE_ENABLE_AI_COACH_RECOMMENDATIONS=false

# Optional: AI-Coach-Session-Abschluss aktivieren (Standard: false)
VITE_ENABLE_AI_COACH_COMPLETION=false

# Optional: AI-Coach-Reflexionsauswertung aktivieren (Standard: false)
VITE_ENABLE_AI_COACH_REFLECTION=false

# Hinweis: Coach-Runtime-Features benötigen aktive `prompt_definitions` in Supabase.
